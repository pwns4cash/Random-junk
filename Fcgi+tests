#!/usr/bin/env python3
"""
FCGI client example - sends a real FastCGI request to query a PHP/Python/whatever FCGI server
Works with: php-fpm, apache+mod_fcgid, nginx + fastcgi backend, etc.

2024–2025 style (using asyncio + modern typing)
"""

import asyncio
import socket
import struct
import sys
from typing import Dict, Optional
from urllib.parse import urlencode


FCGI_BEGIN_REQUEST     = 1
FCGI_ABORT_REQUEST     = 2
FCGI_END_REQUEST       = 3
FCGI_PARAMS            = 4
FCGI_STDIN             = 5
FCGI_STDOUT            = 6
FCGI_STDERR            = 7
FCGI_DATA              = 8
FCGI_GET_VALUES        = 9
FCGI_GET_VALUES_RESULT = 10

FCGI_REQUEST_COMPLETE  = 0
FCGI_CANT_MPX_CONN     = 1
FCGI_OVERLOADED        = 2
FCGI_UNKNOWN_ROLE      = 3

FCGI_RESPONDER         = 1


def pack_header(version: int = 1, ftype: int = 0, req_id: int = 1, content_len: int = 0, padding_len: int = 0) -> bytes:
    return struct.pack(
        "!BBHHBB",
        version,           # version (1)
        ftype,             # type
        req_id,            # requestId (big-endian)
        content_len,       # contentLength (big-endian)
        padding_len,       # paddingLength
        0                  # reserved
    )


def encode_length(length: int) -> bytes:
    """ FCGI name/value pairs use this weird length encoding """
    if length < 128:
        return bytes([length])
    else:
        return struct.pack("!I", length | 0x80000000)


def encode_nv_pair(name: str, value: str) -> bytes:
    n = name.encode("utf-8")
    v = value.encode("utf-8")
    return encode_length(len(n)) + encode_length(len(v)) + n + v


def create_params(req_id: int, params: Dict[str, str]) -> list[bytes]:
    """ Split params into ≤ 65535 byte chunks if needed """
    chunks = []
    body = b""

    for k, v in params.items():
        pair = encode_nv_pair(k, v)
        if len(body) + len(pair) > 65535 - 8:  # leave room for header
            chunks.append(pack_header(FCGI_PARAMS, req_id, len(body)) + body + b"\x00" * ((8 - len(body) % 8) % 8))
            body = b""
        body += pair

    if body:
        padding = b"\x00" * ((8 - len(body) % 8) % 8)
        chunks.append(pack_header(FCGI_PARAMS, req_id, len(body)) + body + padding)

    # Empty PARAMS record = end of parameters
    chunks.append(pack_header(FCGI_PARAMS, req_id, 0))
    return chunks


async def send_fcgi_request(
    host: str = "127.0.0.1",
    port: int = 9000,
    script: str = "/index.php",
    query_string: str = "",
    method: str = "GET",
    content: bytes = b"",
    extra_headers: Optional[Dict[str, str]] = None
) -> tuple[int, str, str]:
    """
    Very basic FCGI client — returns (exit_code, stdout, stderr)
    """
    if extra_headers is None:
        extra_headers = {}

    request_id = 1

    # Very typical PHP-FPM / FCGI environment
    env = {
        "GATEWAY_INTERFACE": "FastCGI/1.0",
        "REQUEST_METHOD": method.upper(),
        "SCRIPT_FILENAME": script,
        "SCRIPT_NAME": script,
        "REQUEST_URI": script + ("?" + query_string if query_string else ""),
        "QUERY_STRING": query_string,
        "SERVER_SOFTWARE": "grok-fcgi-client/1.0",
        "REMOTE_ADDR": "127.0.0.1",
        "REMOTE_PORT": "9981",
        "SERVER_ADDR": "127.0.0.1",
        "SERVER_PORT": str(port),
        "SERVER_PROTOCOL": "HTTP/1.1",
        "SERVER_NAME": "localhost",
        "HTTPS": "off",
        "CONTENT_LENGTH": str(len(content)) if content else "0",
        "CONTENT_TYPE": "application/x-www-form-urlencoded" if method.upper() == "POST" and not extra_headers.get("Content-Type") else "",
    }

    env.update(extra_headers)

    reader, writer = await asyncio.open_connection(host, port)

    # 1. Begin request
    begin_body = struct.pack("!HB7x", FCGI_RESPONDER, 0)  # role + flags
    writer.write(pack_header(FCGI_BEGIN_REQUEST, request_id, 8) + begin_body)

    # 2. Send PARAMS
    for chunk in create_params(request_id, env):
        writer.write(chunk)

    # 3. Send STDIN (empty = end of input for GET)
    if content:
        # For simplicity we send in one chunk — real clients should chunk large bodies
        writer.write(pack_header(FCGI_STDIN, request_id, len(content)) + content)
    writer.write(pack_header(FCGI_STDIN, request_id, 0))  # empty stdin = end

    await writer.drain()

    # 4. Read response
    stdout = []
    stderr = []
    status = 0

    while True:
        header = await reader.readexactly(8)
        if len(header) < 8:
            break

        version, ftype, rid, clen, plen, _ = struct.unpack("!BBHHBB", header)

        if rid != request_id:
            # protocol error — ignore for demo
            await reader.readexactly(clen + plen)
            continue

        body = await reader.readexactly(clen)
        await reader.readexactly(plen)  # padding

        if ftype == FCGI_STDOUT:
            if body:
                stdout.append(body)
        elif ftype == FCGI_STDERR:
            if body:
                stderr.append(body)
        elif ftype == FCGI_END_REQUEST:
            appStatus, protoStatus = struct.unpack("!IB3x", body)
            status = appStatus
            break

    writer.close()
    await writer.wait_closed()

    return status, b"".join(stdout).decode("utf-8", errors="replace"), b"".join(stderr).decode("utf-8", errors="replace")


# ────────────────────────────────────────────────
#                    Examples
# ────────────────────────────────────────────────

async def main():
    # Example 1: simple GET
    status, out, err = await send_fcgi_request(
        host="127.0.0.1",
        port=9000,                     # ← most common php-fpm port
        script="/var/www/html/info.php",
        query_string="name=GroK&test=123",
        method="GET"
    )

    print(f"Status: {status}")
    print("STDOUT:")
    print(out)
    if err:
        print("\nSTDERR:")
        print(err)


    # Example 2: POST form data
    post_data = urlencode({"username": "alice", "password": "secret123"}).encode()

    status, out, err = await send_fcgi_request(
        host="127.0.0.1",
        port=9000,
        script="/login.php",
        method="POST",
        content=post_data,
        extra_headers={
            "Content-Type": "application/x-www-form-urlencoded",
            "X-Forwarded-For": "8.8.8.8"
        }
    )


if __name__ == "__main__":
    asyncio.run(main())
